# Python
__pycache__/
*.pyc
.venv/
.env

# Node
node_modules/
dist/
.next/

# General
*.log
.DS_Store

# Claude Code local session state (not project content)
.claude/

# Source regulatory PDFs -- data, not code. Not committed (binary,
# potentially many, and licensing of official documents varies).
apps/engine/data/incoming/*
!apps/engine/data/incoming/.gitkeep

# Generated batch-review exports and the data-filled review page --
# working output for one review session. The real audit trail is the
# Review table in the database (immutable, with before/after
# snapshots), not these files. The template itself (apps/engine/
# templates/review_page.html) IS committed -- it's source code, just
# kept out of data/.
apps/engine/data/batch_review_*.json
apps/engine/data/review_template.html
apps/engine/data/review_page.html
apps/engine/data/review2_data.json
apps/engine/data/review2_page.html
